# external-dns configuration
# Syncs routes from reverse proxy sources to DNS providers
---
# DNS providers - independent write targets where DNS records are reconciled
# Add one or more providers. Each configured provider is reconciled separately.
providers:
  - name: adguard-home
    provider: adguard # Provider type: adguard (default)
    url: "${DNS_PROVIDER_URL}"
    username: "${DNS_PROVIDER_USERNAME}"
    password: "${DNS_PROVIDER_PASSWORD}"

#  - name: technitium-primary
#    provider: technitium
#    url: "${TECHNITIUM_URL}"
#    api_token: "${TECHNITIUM_API_TOKEN}"
#    zones:
#      - "${DOMAIN}"
#
#  - name: technitium-secondary
#    provider: technitium
#    url: "${TECHNITIUM_SECONDARY_URL}"
#    api_token: "${TECHNITIUM_SECONDARY_API_TOKEN}"
#    zones:
#      - "${DOMAIN}"

# Sources - reverse proxy instances to discover routes from
sources:
  - name: primary
    type: traefik # Source type: traefik (default)
    url: "https://traefik-primary.${DOMAIN}"
    target_ip: "192.168.1.10"
    # verify_tls: false

    # Optional: Filter routers to sync (supports wildcards)
    # Only routers matching this pattern will be synced to DNS
    # Examples:
    #   "*-internal"    - Only sync routers ending with "-internal"
    #   "app-*"         - Only sync routers starting with "app-"
    #   "*-public-*"    - Only sync routers containing "-public-"
    #   ""              - No filter (sync all routers)
    router_filter: ""

    # Filter by middleware (only sync routers using this middleware)
    middleware_filter: "internal"

  - name: public-edge
    type: traefik
    url: "https://traefik-public.${DOMAIN}"
    target_ip: "192.168.1.20"
    # Optional: public_target_ip is used only for external/public routers.
    # Internal routers from this source continue to use target_ip.
    # External routers without public_target_ip remain skipped by default.
    public_target_ip: "${PUBLIC_TARGET_IP}"

  - name: secondary
    type: traefik
    url: "https://traefik-secondary.${DOMAIN}"
    target_ip: "192.168.1.30"

# Runtime settings (env vars override if set)
settings:
  # Sync mode: "watch" (continuous polling) or "once" (single run)
  sync_mode: watch

  # Poll interval in seconds (watch mode only)
  poll_interval: 60

  # Logging level: DEBUG, INFO, WARNING, ERROR
  log_level: INFO

  # Default zone for discovered routes: "internal" or "external"
  # - internal: Create DNS rewrites in local DNS provider
  # - external: Skip local DNS by default unless source public_target_ip is set
  default_zone: internal

# Domain exclusion patterns
# Supports: exact match, wildcards (*.example.com), regex (~^dev-\d+\.example\.com$)
exclude_domains:
  # Exclude Traefik dashboard URLs (management interfaces)
  - "traefik-primary.${DOMAIN}"
  - "traefik-public.${DOMAIN}"
  - "traefik-secondary.${DOMAIN}"

# Static DNS rewrites (always ensured, not auto-removed)
# Format: domain: ip_or_cname
static_rewrites:
  "static.${DOMAIN}": "192.168.1.10"

# Webhook - trigger external services after DNS changes
# Useful for triggering adguardhome-sync or other automation
webhook:
  url: "${EXTERNAL_DNS_WEBHOOK_URL}"
  username: "${EXTERNAL_DNS_WEBHOOK_USERNAME}"
  password: "${EXTERNAL_DNS_WEBHOOK_PASSWORD}"
  method: POST
  timeout: 30
  only_on_changes: true
